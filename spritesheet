import pygame

class SpriteSheet:
    def __init__ (self, image):
        self.sheet = image

def get_image(self, frame, w, h, colour):
    image = pygame.surface.Surface((w, h)).convert_alpha()
    image.blit(self.sheet, (0, 0), ((frame*w), 0, w, h))
    image.set_colorkey(colour)

    return image